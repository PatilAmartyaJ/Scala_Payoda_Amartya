# An example controller showing a sample home page
GET     /                           controllers.HomeController.index()

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)


POST  /api/zone                      controllers.ZoneController.createZone()
GET  /api/zone                       controllers.ZoneController.getAllZones()

GET /api/zone/pollutionHistory/:date/:zoneId    controllers.DailyPollutionSummaryController.getByDateAndZone(date,zoneId)


GET /api/zone/:zoneId/recentReadings  controllers.ZoneController.getRecentRecordsByZone(zoneId,limit: Option[String])

GET /api/zone/:zoneId/dailySummary   controllers.DailyPollutionSummaryController.getByZone(zoneId)

POST /api/pollutionThreshold         controllers.PollutionThresholdController.createPollutionThreshold()
